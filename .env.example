# Copy to .env.local; use values from `npm exec -- supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Set to the canonical deployment origin in production; local defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-site.example
SUPABASE_SECRET_KEY=replace-with-local-secret-key
